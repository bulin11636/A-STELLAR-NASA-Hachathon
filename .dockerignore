# An allowlist keeps datasets, credentials and local artifacts out of every stage.
**
!Dockerfile
!backend/
!backend/pyproject.toml
!backend/constraints-runtime.txt
!backend/app/
!backend/app/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
