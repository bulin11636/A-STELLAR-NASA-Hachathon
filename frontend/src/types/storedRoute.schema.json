          "title": "Distance M"
        },
        "estimated_time_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Time Min"
        },
        "risk_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Score"
        }
      },
      "required": [
        "distance_m",
        "estimated_time_min",
        "risk_score"
      ],
      "title": "RouteMetrics",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "const": "jezero",
          "default": "jezero",
          "title": "Region Id",
          "type": "string"
        },
        "roi_id": {
          "title": "Roi Id",
          "type": "string"
        },
        "dataset_version": {
          "title": "Dataset Version",
          "type": "string"
        },
        "bounds": {
