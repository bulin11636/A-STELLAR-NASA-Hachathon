          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "input_filename": {
          "title": "Input Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "instrument": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instrument"
        },
        "mission": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mission"
        },
        "acquisition_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acquisition Time"
        },
        "provenance_record_id": {
          "title": "Provenance Record Id",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "source_url",
        "input_filename",
        "sha256",
        "instrument",
        "mission",
        "acquisition_time",
        "provenance_record_id"
      ],
      "title": "Source",
      "type": "object"
