      "properties": {
        "model": {
          "default": "gpt-6.1-sol",
          "title": "Model",
          "type": "string"
        },
        "reasoning_effort": {
          "default": "medium",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "calls": {
          "default": 0,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
