          "default": null,
          "title": "Model Commentary"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "facts",
        "limitations",
        "model_commentary",
        "evidence_ids"
      ],
      "title": "Rationale",
      "type": "object"
    },
    "RouteMetadata": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/PlanRouteRequest"
        },
        "coordinator": {
          "$ref": "#/$defs/Coordinator"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "grid": {
          "$ref": "#/$defs/GridMetadata"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "planner": {
          "$ref": "#/$defs/Planner"
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        },
        "workers": {
          "items": {
            "$ref": "#/$defs/Worker"
          },
          "title": "Workers",
          "type": "array"
        },
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Warnings",
          "type": "array"
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rationale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_route_id": {
          "anyOf": [
            {
              "pattern": "^route-[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Route Id"
        }
      },
      "required": [
        "schema_version",
        "route_id",
        "created_at",
        "request",
        "coordinator",
        "scope",
        "sources",
        "grid",
        "policy",
        "planner",
        "validation",
        "workers",
        "artifacts",
        "warnings",
        "rationale",
        "usage",
        "parent_route_id"
      ],
      "title": "RouteMetadata",
      "type": "object"
    },
    "RouteMetrics": {
      "additionalProperties": false,
